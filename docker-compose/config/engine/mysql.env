# The values of DB_ENGINE=mysql (the MySQL protocol; the server is MariaDB
# 13.0). docker-compose.yaml loads this file after .env. Do not change it:
# change DB_ENGINE in .env.
# The port of the database server in the Compose network.
DB_PORT=3306
# The admin user that makes the databases and the read-only users.
DB_ADMIN_USER=root
# The image of database-init (it has the mariadb client).
DB_CLIENT_IMAGE=${MARIADB_IMAGE}
