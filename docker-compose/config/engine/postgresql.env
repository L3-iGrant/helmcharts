# The values of DB_ENGINE=postgresql. docker-compose.yaml loads this file
# after .env. Do not change it: change DB_ENGINE in .env.
# The port of the database server in the Compose network.
DB_PORT=5432
# The superuser that makes the databases and the read-only users.
DB_ADMIN_USER=postgres
# The image of database-init (it has the psql client).
DB_CLIENT_IMAGE=${POSTGRES_IMAGE}
